#: build/index.js:1 build/index.js:3 src/index.js:26 src/index.js:108
msgid "Excerpt"
msgstr "抜粋"

#: build/index.js:1 src/index.js:27
msgid "Menu order"
msgstr "メニュー順"

#: build/index.js:1 src/index.js:28
msgid "Comment status"
msgstr "コメント状態"

#: build/index.js:1 src/index.js:29
msgid "Ping status"
msgstr "Ping 状態"

#: build/index.js:1 src/index.js:30
